# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.hypothesis/
# Node
node_modules/
# Flutter/Dart
.dart_tool/
build/
# Secrets / local
secrets/
.env
*.keystore
*.jks
*.p12
*.mobileprovision
# Evidence raw dumps that may contain personal data
docs/sources/raw/
.ruff_cache/
# Dev database secret generated by tools/dev-db.sh (T-002)
deploy/secrets.dev/
# Deployment secrets generated by tools/gen-secrets.sh (T-012): everything in deploy/secrets/
# stays ignored except its README (the rule "secrets/" above would hide the README too).
!deploy/secrets/
deploy/secrets/*
!deploy/secrets/README.md
