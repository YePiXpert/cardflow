# CardFlow deployment settings (T-012; deployment-ops §2). NON-SECRET values only.
# Copy to deploy/.env (git-ignored) and adjust:   cp deploy/.env.example deploy/.env
# Compose reads deploy/.env twice: to fill ${...} in compose.yaml and, via env_file, as the
# environment of the cardflow/api containers. Passwords and keys never go here: they live in
# deploy/secrets/ (tools/gen-secrets.sh) and reach the containers as Compose secrets.
# DATABASE_URL and *_FILE are set per service in compose.yaml (each process has its own role).

# Image tag cardflow/api:<CARDFLOW_VERSION>; required. tools/build-api-image.sh prints it.
CARDFLOW_VERSION=
# Host port published on 127.0.0.1 only (the bind address is fixed in compose.yaml).
CARDFLOW_API_PORT=18080

# CP-SAT solver (the worker container is limited to 4 CPUs) and document parsing.
SOLVER_TIME_LIMIT_S=10
SOLVER_WORKERS=8
PARSE_TIMEOUT_S=120
MAX_UPLOAD_MB=25

# Optional AI adapters (ADR-013): off unless explicitly enabled.
AI_ENABLED=false
AI_PROVIDER=
AI_REGION=

# Promotion fetch allow-list, comma-separated; empty = fetch nothing.
PROMO_ALLOWED_DOMAINS=

# Per-device limits per window (api-contract §1).
RATE_LIMIT_WINDOW_S=600
RATE_LIMIT_DEVICE_REQUESTS=600
RATE_LIMIT_SOLVE_REQUESTS=30
RATE_LIMIT_UPLOAD_REQUESTS=20

# Logs are JSON with a field whitelist (no PII).
LOG_LEVEL=info
LOG_FORMAT=json

# Backups (T-013).
BACKUP_CRON="0 3 * * *"
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8

TOMBSTONE_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
MIN_CLIENT_VERSION=1.0.0

# /docs, /redoc and /openapi.json: keep false in production.
API_DOCS_ENABLED=false
