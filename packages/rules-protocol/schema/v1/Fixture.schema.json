{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rules-protocol.cardflow.invalid/v1/Fixture.schema.json",
  "title": "Fixture",
  "description": "A golden fixture: one PlanInput plus expected results. Each case computes one output -- 'cycles' (billing cycle of every card), 'verify' (independent verifier on a given allocation; no solver) or 'plan' (full engine run with the case's profile and decision scenario replacing input.options) -- and checks it with assertions. Runners without CP-SAT (Dart) run 'cycles' and 'verify' cases and report 'plan' cases as not run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "fixture_id", "input", "expected"],
  "properties": {
    "protocol_version": { "$ref": "common.schema.json#/$defs/ProtocolVersion" },
    "fixture_id": { "$ref": "common.schema.json#/$defs/Id" },
    "description": { "$ref": "common.schema.json#/$defs/Text" },
    "source": {
      "description": "Provenance of a fixture derived from another file (path relative to packages/rules-protocol).",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "converter"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256": { "$ref": "common.schema.json#/$defs/Sha256Hex" },
        "converter": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "input": { "$ref": "PlanInput.schema.json" },
    "expected": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Case" }
    }
  },
  "$defs": {
    "CaseName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
    "Case": {
      "oneOf": [
        { "$ref": "#/$defs/CyclesCase" },
        { "$ref": "#/$defs/VerifyCase" },
        { "$ref": "#/$defs/PlanCase" }
      ]
    },
    "CyclesCase": {
      "description": "Output: PlanOutcome.schema.json#/$defs/CardCycles.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "assertions"],
      "properties": {
        "name": { "$ref": "#/$defs/CaseName" },
        "kind": { "const": "cycles" },
        "assertions": { "$ref": "#/$defs/Assertions" }
      }
    },
    "VerifyCase": {
      "description": "Output: PlanOutcome.schema.json#/$defs/VerificationResult.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "allocation", "decision_scenario", "assertions"],
      "properties": {
        "name": { "$ref": "#/$defs/CaseName" },
        "kind": { "const": "verify" },
        "allocation": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/AllocationItem" }
        },
        "decision_scenario": { "$ref": "common.schema.json#/$defs/Id" },
        "assertions": { "$ref": "#/$defs/Assertions" }
      }
    },
    "PlanCase": {
      "description": "Output: PlanOutcome.schema.json.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "profile", "decision_scenario", "assertions"],
      "properties": {
        "name": { "$ref": "#/$defs/CaseName" },
        "kind": { "const": "plan" },
        "profile": { "$ref": "common.schema.json#/$defs/Profile" },
        "decision_scenario": { "$ref": "common.schema.json#/$defs/Id" },
        "assertions": { "$ref": "#/$defs/Assertions" }
      }
    },
    "AllocationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_id", "amount_minor"],
      "properties": {
        "card_id": { "$ref": "common.schema.json#/$defs/Id" },
        "amount_minor": { "$ref": "common.schema.json#/$defs/PositiveMinorAmount" }
      }
    },
    "Assertions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Assertion" }
    },
    "JsonPointer": {
      "description": "RFC 6901 JSON Pointer into the case output ('' = the whole output).",
      "type": "string",
      "pattern": "^(/([^~/]|~[01])*)*$"
    },
    "Where": {
      "description": "Selects the single array element (an object) whose listed fields equal these values.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "type": ["string", "integer", "boolean"] }
    },
    "Assertion": {
      "description": "Resolve 'path'; with 'where', that value must be an array with exactly one matching element, then resolve 'then' (default '') inside it. 'equals' compares JSON values strictly (booleans are not numbers, integers are not floats); 'length' compares the size of an array or object. 'from' records where the expectation came from.",
      "oneOf": [{ "$ref": "#/$defs/EqualsAssertion" }, { "$ref": "#/$defs/LengthAssertion" }]
    },
    "EqualsAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "equals"],
      "dependentRequired": { "then": ["where"] },
      "properties": {
        "path": { "$ref": "#/$defs/JsonPointer" },
        "where": { "$ref": "#/$defs/Where" },
        "then": { "$ref": "#/$defs/JsonPointer" },
        "equals": {
          "description": "Expected JSON value; money as integer minor units, never a float."
        },
        "from": { "$ref": "common.schema.json#/$defs/Text" }
      }
    },
    "LengthAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "length"],
      "dependentRequired": { "then": ["where"] },
      "properties": {
        "path": { "$ref": "#/$defs/JsonPointer" },
        "where": { "$ref": "#/$defs/Where" },
        "then": { "$ref": "#/$defs/JsonPointer" },
        "length": { "$ref": "common.schema.json#/$defs/Count" },
        "from": { "$ref": "common.schema.json#/$defs/Text" }
      }
    }
  }
}
